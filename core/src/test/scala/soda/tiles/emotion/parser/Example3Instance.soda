class Example3Instance

  abstract

  fluents : Map [FluentValue] [FluentName] =
    Map [FluentValue] [FluentName] (
      ("informed" , "information") ,
      ("uninformed" , "information")
    )

  actions : ActionSet =
    Seq [Action] (
      "read_truth" ,
      "read_lie" ,
      "share_truth" ,
      "share_lie"
    ) .toSet

  rules : RuleSeq = Seq [Rule] (
    ContravenesRule (
      Seq [FluentValue] (
        "informed"
      ) .toSet ,
      "share_lie"
    ) ,
    NoConcurrencyRule (
      Seq [Action] (
        "read_truth" ,
        "read_lie"
      ) .toSet
    ) ,
    NoConcurrencyRule (
      Seq [Action] (
        "share_truth" ,
        "share_lie"
      ) .toSet
    )
  )

  trajectory : Seq [IdentifierSet] =
    Seq [IdentifierSet] (
      Seq [FluentValue] (
        "uninformed"
      ) .toSet ,
      Seq [Action] (
        "read_lie"
      ) .toSet ,
      Seq [FluentValue] (
        "uninformed"
      ) .toSet ,
      Seq [Action] (
        "share_lie"
      ) .toSet ,
      Seq [FluentValue] (
        "uninformed"
      ) .toSet ,
      Seq [Action] (
        "read_truth"
      ) .toSet ,
      Seq [FluentValue] (
        "informed"
      ) .toSet ,
      Seq [Action] (
        "read_lie"
      ) .toSet ,
      Seq [FluentValue] (
        "informed"
      ) .toSet ,
      Seq [Action] (
        "share_lie"
      ) .toSet ,
      Seq [FluentValue] (
        "informed"
      ) .toSet
    )

  instance : Configuration =
    Configuration .mk (fluents) (actions) (rules) (trajectory)

end
