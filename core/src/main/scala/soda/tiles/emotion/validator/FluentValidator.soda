
class FluentValidator

  abstract

  error_unknown_fluent = "unknown fluent ----> "

  error_duplicate_fluent_mapping = "contradictory fluent values for ----> "

  validate_keys (fluent_set : FluentSet) (fluent_map : FluentMap) : Seq [String] =
    fluent_set
      .toSeq
      .filter (lambda x --> not fluent_map .contains (x) )
      .map (lambda x --> error_unknown_fluent + x .toString)

  validate_fluent (fluent : FluentName) (fluent_map : FluentMap) : Seq [String] =
    validate_keys (Seq [FluentName] (fluent) .toSet) (fluent_map)

  mapped (fluent_set : FluentSet) (fluent_map : FluentMap) : Seq [Identifier] =
    fluent_set
      .toSeq
      .filter (lambda x --> fluent_map .contains (x) )
      .map (lambda x --> fluent_map .get (x) .get)

  validate_injective (fluent_set : FluentSet) (fluent_map : FluentMap) (mapped : Seq [Identifier] )
      : Seq [String] =
    mapped
      .toSet
      .filter (lambda x -->
        mapped .count (lambda y --> x == y) > 1 )
      .toSeq
      .map (lambda x --> error_duplicate_fluent_mapping + x .toString)

  validate (fluent_set : FluentSet) (fluent_map : FluentMap) : Seq [String] =
    validate_keys (fluent_set) (fluent_map) .++ (
      validate_injective (fluent_set) (fluent_map) (mapped (fluent_set) (fluent_map) ) )

  is_valid (fluent_set : FluentSet) (fluent_map : FluentMap) : Boolean =
    validate (fluent_set) (fluent_map) .isEmpty

end

