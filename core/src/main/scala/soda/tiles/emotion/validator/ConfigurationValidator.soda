
class ConfigurationValidator

  abstract

  rv = RuleValidator .mk

  tv = TrajectoryValidator .mk

  is_valid (conf : Configuration) : Boolean =
    conf .rules .forall (lambda x -->
      rv .is_valid (x) (conf .fluents) (conf .actions)
    ) and tv .is_valid (conf .trajectory) (conf .fluents) (conf .actions)

end

