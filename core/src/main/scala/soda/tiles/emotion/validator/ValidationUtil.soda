
class ValidationUtil

  abstract

  separator = "\n"

  empty = ""

  concatenate (seq : Seq [Option [String] ] ) : Option [String] =
    if (seq .exists (lambda x --> x .isDefined) )
    then Some (
      seq
        .filter (lambda x --> x .isDefined)
        .map (lambda x --> x .getOrElse (empty) )
        .mkString (separator)
    )
    else None

  concatenate_pair (fst : Option [String] ) (snd : Option [String] ) : Option [String] =
    concatenate (
      Seq [Option [String] ] (fst , snd)
    )

  concatenate_triplet (fst : Option [String] ) (snd : Option [String] ) (trd : Option [String] ) : Option [String] =
    concatenate (
      Seq [Option [String] ] (fst , snd , trd)
    )

end

