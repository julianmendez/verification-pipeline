

class SlidingWindow

  abstract
    defined : Boolean
    s0 : Option [FluentSet]
    a : Option [ActionSet]
    s1 : Option [FluentSet]
    accum : Seq [Transition]

end


class TransitionBuilder

  abstract

  fold = Fold .mk

  _process_input_state (sw : SlidingWindow) (elem : FluentOrActionSet) : SlidingWindow =
    match elem
      case FluentSetType (s0) ==> SlidingWindow .mk (sw .defined) (Some (s0) ) (sw .a) (sw .s1) (sw .accum)
      case ActionSetType (a) ==> SlidingWindow .mk (false) (sw .s0) (sw .a) (sw .s1) (sw .accum)

  _process_action (sw : SlidingWindow) (elem : FluentOrActionSet) : SlidingWindow =
    match elem
      case ActionSetType (a) ==> SlidingWindow .mk (sw .defined) (sw .s0) (Some (a) ) (sw .s1) (sw .accum)
      case FluentSetType (s) ==> SlidingWindow .mk (false) (sw .s0) (sw .a) (sw .s1) (sw .accum)

  _process_output_state (sw : SlidingWindow) (elem : FluentOrActionSet) : SlidingWindow =
    match elem
      case FluentSetType (s1) ==> SlidingWindow .mk (sw .defined) (sw .s0) (sw .a) (Some (s1) ) (sw .accum)
      case ActionSetType (a) ==> SlidingWindow .mk (false) (sw .s0) (sw .a) (sw .s1) (sw .accum)

  _process_window (sw : SlidingWindow) (elem : FluentOrActionSet) : SlidingWindow =
    if (not (sw .defined) )
    then sw
    else
      if (sw .s0 .isEmpty)
      then _process_input_state (sw) (elem)
      else
        if (sw .a .isEmpty)
        then _process_action (sw) (elem)
        else
          if (sw .s1 .isEmpty)
          then _process_output_state (sw) (elem)
          else SlidingWindow .mk (false) (sw .s0) (sw .a) (sw .s1) (sw .accum)

  _empty_sliding_window : SlidingWindow =
    SlidingWindow .mk (true) (None) (None) (None) (Seq [Transition] () )

  _postprocess (sw : SlidingWindow) : Option [Seq [Transition] ] =
    if (sw .defined) and (sw .s0 .isEmpty) and (sw .a .isEmpty) and (sw .s1 .isEmpty)
    then Some (sw .accum)
    else None

  make_instants (seq : Seq [FluentOrActionSet] ) : Option [Seq [Transition] ] =
    _postprocess (
      fold (seq) (_empty_sliding_window) (_process_window)
    )

end

