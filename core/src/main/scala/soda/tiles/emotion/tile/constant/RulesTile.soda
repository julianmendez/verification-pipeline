
directive lean
import Soda.tiles.emotion.entity.TileMessage


/**
 * This tile returns the rules.
 */

class RulesTile

  abstract

  get_rules (message : TileMessage [Boolean] ) : Context =
    message .context

  apply (message : TileMessage [Boolean] ) : TileMessage [Context] =
    TileMessageBuilder .mk .build (message .context) (message .instance) (
      get_rules (message)
    )

end

