

class SlidingWindow

  abstract
    defined : Boolean
    s0 : Option [FluentSet]
    a : Option [ActionSet]
    accum : Seq [Transition]

end


class TransitionsTile

  abstract

  process_action (sw : SlidingWindow) (elem : IdentifierSet) : SlidingWindow =
    if (sw .a .isEmpty)
    then
      SlidingWindow .mk (sw .defined) (sw .s0) (Some (elem) ) (
        sw .accum
      )
    else
      SlidingWindow .mk (sw .defined) (Some (elem) ) (None) (
        (sw .accum) .:+ (Transition .mk (sw .s0 .get) (sw .a .get) (elem) )
      )

  process_input_state (sw : SlidingWindow) (elem : IdentifierSet) : SlidingWindow =
    if (sw .s0 .isEmpty)
    then SlidingWindow .mk (sw .defined) (Some (elem) ) (sw .a) (sw .accum)
    else process_action (sw) (elem)

  process_window (sw : SlidingWindow) (elem : IdentifierSet) : SlidingWindow =
    if (not (sw .defined) )
    then sw
    else process_input_state (sw) (elem)

  empty_sliding_window : SlidingWindow =
    SlidingWindow .mk (true) (None) (None) (Seq [Transition] () )

  postprocess (sw : SlidingWindow) : Seq [Transition] =
    if (sw .defined) and (sw .a .isEmpty)
    then sw .accum
    else Seq [Transition] ()

  apply_tile = ApplyTile .mk [SlidingWindow] [Seq [Transition] ] (postprocess)

  fold_tile = FoldTile .mk (empty_sliding_window) (process_window)

  apply (message : TileMessage [Trajectory] ) : TileMessage [TransitionSeq] =
    apply_tile .apply (
      fold_tile .apply (
        message
      )
    )

end

