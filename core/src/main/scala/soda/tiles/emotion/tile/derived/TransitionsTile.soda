

class SlidingWindow

  abstract
    defined : Boolean
    s0 : Option [FluentSet]
    a : Option [ActionSet]
    accum : Seq [Transition]

end


class TransitionsTile

  abstract

  fold = Fold .mk

  _process_action (sw : SlidingWindow) (elem : IdentifierSet) : SlidingWindow =
    if (sw .a .isEmpty)
    then
      SlidingWindow .mk (sw .defined) (sw .s0) (Some (elem) ) (
        sw .accum
      )
    else
      SlidingWindow .mk (sw .defined) (Some (elem) ) (None) (
        (sw .accum) .:+ (Transition .mk (sw .s0 .get) (sw .a .get) (elem) )
      )

  _process_input_state (sw : SlidingWindow) (elem : IdentifierSet) : SlidingWindow =
    if (sw .s0 .isEmpty)
    then SlidingWindow .mk (sw .defined) (Some (elem) ) (sw .a) (sw .accum)
    else _process_action (sw) (elem)

  _process_window (sw : SlidingWindow) (elem : IdentifierSet) : SlidingWindow =
    if (not (sw .defined) )
    then sw
    else _process_input_state (sw) (elem)

  _empty_sliding_window : SlidingWindow =
    SlidingWindow .mk (true) (None) (None) (Seq [Transition] () )

  _postprocess (sw : SlidingWindow) : Option [Seq [Transition] ] =
    if (sw .defined) and (sw .a .isEmpty)
    then Some (sw .accum .reverse)
    else None

  make_instants (seq : Seq [IdentifierSet] ) : Option [TransitionSeq] =
    _postprocess (
      fold (seq) (_empty_sliding_window) (_process_window)
    )

  make_transitions (seq : Trajectory) : TransitionSeq =
    make_instants (seq) .getOrElse (Seq [Transition] () )

  apply (message : TileMessage [Trajectory] ) : TileMessage [TransitionSeq] =
    TileMessageBuilder .mk .build (message .context) (message .instance) (
      make_transitions (message .contents)
    )

end

