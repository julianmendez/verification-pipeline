
class CrossPreprocessorVerifierTile

  abstract

  cross_tile = CrossTile .mk [Transition] [Rule]

  preprocessor_tile = PreprocessorTile .mk

  verifier_tile = VerifierTile .mk

  apply (message0 : TileMessage [TransitionSeq] ) (message1 : TileMessage [RuleSeq] )
      : TileMessage [Seq [TileQuad [Transition] [Rule] [ActionSet] [Boolean] ] ] =
    verifier_tile .apply (
      preprocessor_tile .apply (
        cross_tile .apply (
          message0
        ) (
          message1
        )
      )
    )

end

