
directive lean
import Soda.tiles.emotion.entity.Entity


class TilePair [A : Type] [B : Type]

  abstract
    fst : A
    snd : B

end


class TileTriple [A : Type] [B : Type] [C : Type]

  abstract
    fst : A
    snd : B
    trd : C

end


class TileMessage [A : Type]

  abstract
    context : RuleSet
    instance : Trajectory
    contents : A

end


class TileMessageBuilder

  abstract

  build [A : Type] (context : Context) (instance : Instance) (contents : A) : TileMessage [A] =
    TileMessage .mk (context) (instance) (contents)

end

