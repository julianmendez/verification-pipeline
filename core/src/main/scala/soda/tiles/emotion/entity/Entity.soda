
class Identifier = String


class Action = Identifier


class FluentName = Identifier


class FluentValue = Boolean


class Fluent

  abstract
    name : FluentName
    value : FluentValue

end


class FluentSet = Set [Fluent]


class ActionSet = Set [Action]


datatype FluentOrActionSet
  FluentSetType : (fluent_set : FluentSet) -> FluentOrActionSet
  ActionSetType : (action_set : ActionSet) -> FluentOrActionSet


class Transition

  abstract
    input : FluentSet
    actions : ActionSet
    output : FluentSet

end


