
class ListParser

  abstract

  parse_string_part (e : Any) : Option [String] =
    match e
      case s : String ==> Some (s)
      case otherwise ==> None

  parse_string_list (part : Any) : Option [List [String] ] =
    match part
      case p : Seq [Any] ==>
        Some (p .flatMap (lambda e --> parse_string_part (e) ) .toList)
      case otherwise ==> None

  parse_named_list_part (p : Tuple2 [Any] [Any] ) : Option [Tuple2 [String] [List [String] ] ] =
    match p ._1
      case k : String ==> parse_string_list (p ._2) .map (lambda lst --> Tuple2 (k , lst) )
      case otherwise ==> None

  parse_named_list (part : Any) : Option [Tuple2 [String] [List [String] ] ] =
    match part
      case p : Tuple2 [Any] [Any] ==> parse_named_list_part (p)
      case otherwise ==> None

  parse (a : Seq [Any] ) : Option [List [Any] ] =
    None

end

