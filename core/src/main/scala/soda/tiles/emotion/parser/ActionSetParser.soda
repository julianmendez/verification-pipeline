
class ActionSetParser

  abstract

  identifier = "actions"

  parse_actions (part : Any) : Option [ActionSet] =
    match part
      case (a , s) ==>
        if (a == identifier)
        then
          Some (
            ListParser .mk
              .parse_string_list (s)
              .map (lambda x --> x .toString)
              .toSet
          )
        else None
      case otherwise ==>
        None

  def parse (a : Any) : Option [ActionSet] =
    parse_actions (a)

end
