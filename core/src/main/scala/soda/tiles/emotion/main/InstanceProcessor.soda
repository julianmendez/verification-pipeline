
class InstanceProcessor

  abstract

  error_undefined_result = "undefined result because the input instance is invalid"

  error_configuration_is_undefined = "the input file cannot be read or the instance read is invalid"

  error_processing_instance = "error processing instance maybe due to a misspelled keyword"

  get_extended_trajectory (trajectory : Trajectory) (iterations : Int) : Trajectory =
    if (trajectory .size >= 3) and (not (trajectory .size % 2 == 0) )
    then
      Seq
        .fill (iterations) (trajectory .tail)
        .iterator
        .flatten
        .toSeq
        .+: (trajectory .head)
    else
      trajectory

  get_extended_configuration (conf : Configuration) (iterations : Int) : Configuration =
    Configuration .mk (conf .fluents) (conf .actions) (conf .rules) (
      get_extended_trajectory (conf .trajectory) (iterations)
    )

  get_transition_index (test_index : Int) (rule_set_size : Int) : Int =
    if (rule_set_size > 0)
    then test_index / rule_set_size
    else 0

  process_configuration (configuration : Configuration) : Seq [TransitionReport] =
    EmotionalReasoningPipeline .mk
      .run (InstanceBuilder .mk .build (configuration) )
      .contents
      .zipWithIndex
      .map (lambda x -->
        TransitionReport .mk (x ._2) (get_transition_index (x ._2) (configuration .rules .size) ) (
          x ._1 .fst) (x ._1 .snd) (x ._1 .trd) (x ._1 .fth)
      )

  mk_final_report (iterations : Int) (transitions : Seq [TransitionReport] ) (errors : Seq [String] ) (
      reading_start : Long) (validation_start : Long) (execution_start : Long) : FinalReport =
    FinalReport .mk (
      iterations) (
      transitions) (
      errors) (
      validation_start - reading_start) (
      execution_start - validation_start) (
      System .nanoTime () - execution_start
    )

  process_after_computation (seq : Seq [TransitionReport] ) (errors : Seq [String] ) (iterations : Int) (
      reading_start : Long) (validation_start : Long) (execution_start : Long) : FinalReport =
    if seq .isEmpty
    then
      mk_final_report (iterations) (seq) (
        errors .++ (Seq [String] (error_processing_instance) )
      ) (reading_start) (validation_start) (execution_start)
    else mk_final_report (iterations) (seq) (errors) (reading_start) (validation_start) (execution_start)

  process_validated_instance (conf : Configuration) (errors : Seq [String] ) (iterations : Int) (
      reading_start : Long) (validation_start : Long) (execution_start : Long) : FinalReport =
    if errors .isEmpty
    then
      process_after_computation (
        process_configuration (conf)
      ) (errors) (iterations) (reading_start) (validation_start) (execution_start)
    else mk_final_report (iterations) (Seq .empty) (errors) (reading_start) (validation_start) (execution_start)

  process_instance (reading_start : Long) (conf : Configuration) (iterations : Int) (validation_start : Long)
      : FinalReport =
    process_validated_instance (conf) (
      ConfigurationValidator .mk .validate (conf)
    ) (iterations) (reading_start) (validation_start) (System .nanoTime () )

  process_maybe_instance (reading_start : Long) (maybe_conf : Option [Configuration] ) (
      iterations : Int) (validation_start : Long) : FinalReport =
    match maybe_conf
      case Some (conf) ==>
        process_instance (reading_start) (
          get_extended_configuration (conf) (iterations)
        ) (iterations) (validation_start)
      case None ==>
        mk_final_report (iterations) (Seq .empty) (
          Seq [String] (error_configuration_is_undefined)
        ) (reading_start) (validation_start) (System .nanoTime () )

end

