
/**
 * This is the main entry point.
 */

class Main

  abstract

  help = "" +
    "\nEmotional Reasoning" +
    "\n" +
    "\nCopyright 2026 Julian Alfredo Mendez" +
    "\nhttps://julianmendez.github.io/emotional-reasoning" +
    "\n" +
    "\nParameter: FILE_NAME" +
    "\n" +
    "\n  FILE_NAME     YAML file containing the instance" +
    "\n" +
    "\n"

  help_file : String = "/docs/help.txt"

  get_maybe_configuration (maybe_content : Try [String] ) : Option [Configuration] =
    if maybe_content .isSuccess
    then YamlParser .mk .parse ( @new StringReader (maybe_content .get) )
    else None

  process_input_file (file_name : String) : String =
    Serializer .mk .serialize (
      InstanceProcessor .mk .process_instance (
        get_maybe_configuration (
          SimpleFileReader .mk .try_read_file (file_name)
        )
      )
    )

  execute (arguments : List [String] ) : Unit =
    if (arguments .length > 0)
    then println (process_input_file (arguments (0) ) )
    else
      println (
        SimpleFileReader .mk
          .try_read_resource (help_file)
          .getOrElse (help)
      )

  main (arguments : Array [String] ) : Unit =
    execute (arguments .toList)

end

