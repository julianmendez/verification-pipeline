
/**
 * This is the main entry point.
 */

class Main

  abstract

  help = "" +
    "\nEmotional Reasoning" +
    "\n" +
    "\nCopyright 2026 Julian Alfredo Mendez" +
    "\nhttps://julianmendez.github.io/emotional-reasoning" +
    "\n" +
    "\nEmotional Reasoning is a project that instantiates the Tiles framework." +
    "\n" +
    "\nParameter: FILE_NAME" +
    "\n" +
    "\n  FILE_NAME     YAML file containing the instance" +
    "\n" +
    "\n"

  error_undefined_result = "undefined result because the input instance is invalid"

  error_configuration_is_undefined = "the input instance is invalid"

  read_file (file_name : String) : String =
    @new String (Files .readAllBytes (Paths .get (file_name) ) )

  yaml_parser = YamlParser .mk

  serializer = Serializer .mk

  instance_builder = InstanceBuilder .mk

  cv = ConfigurationValidator .mk

  emotional_reasoning_pipeline = EmotionalReasoningPipeline .mk

  get_transition_index (test_index : Int) (rule_set_size : Int) : Int =
    if (rule_set_size > 0)
    then test_index / rule_set_size
    else 0

  process_configuration (configuration : Configuration) : Seq [TransitionReport] =
    emotional_reasoning_pipeline
      .run (
        instance_builder .build (configuration) )
      .contents
      .zipWithIndex
      .map (lambda x -->
        TransitionReport .mk (x ._2) (get_transition_index (x ._2) (configuration .rules .size) ) (
          x ._1 .fst) (x ._1 .snd) (x ._1 .trd) (x ._1 .fth)
      )

  process_instance_with (conf : Configuration) (errors : Seq [String] ) : FinalReport =
    if errors .isEmpty
    then FinalReport .mk (process_configuration (conf) ) (errors)
    else FinalReport .mk (Seq .empty) (errors)

  process_instance (maybe_conf : Option [Configuration] ) : FinalReport =
    match maybe_conf
      case Some (conf) ==> process_instance_with (conf) (cv .validate (conf) )
      case None ==> FinalReport .mk (Seq .empty) (Seq [String] (error_configuration_is_undefined) )

  get_maybe_configuration (file_name : String) : Option [Configuration] =
    yaml_parser .parse ( @new StringReader (read_file (file_name) ) )

  process_input_file (file_name : String) : String =
    serializer .serialize (
      process_instance (
        get_maybe_configuration (file_name)
      )
    )

  execute (arguments : List [String] ) : Unit =
    if (arguments .length > 0)
    then println (process_input_file (arguments (0) ) )
    else println (help)

  main (arguments : Array [String] ) : Unit =
    execute (arguments .toList)

end

