
/**
 * This is the main entry point.
 */

class Main

  abstract

  help = "" +
    "\nEmotional Reasoning" +
    "\n" +
    "\nCopyright 2026 Julian Alfredo Mendez" +
    "\nhttps://julianmendez.github.io/emotional-reasoning" +
    "\n" +
    "\nEmotional Reasoning is a project that instantiates the Tiles framework." +
    "\n" +
    "\nParameter: FILE_NAME" +
    "\n" +
    "\n  FILE_NAME     YAML file containing the instance" +
    "\n" +
    "\n"

  error_undefined_result = "Undefined result - The input instance is invalid."

  error_configuration_is_undefined = "Error : the instance is invalid."

  read_file (file_name : String) : String =
    @new String (Files .readAllBytes (Paths .get (file_name) ) )

  yaml_parser = YamlParser .mk

  serializer = Serializer .mk

  instance_builder = InstanceBuilder .mk

  cv = ConfigurationValidator .mk

  emotional_reasoning_pipeline = EmotionalReasoningPipeline .mk

  process_configuration (configuration : Configuration)
      : Seq [TileQuad [Transition] [Rule] [ActionSet] [Boolean] ] =
    emotional_reasoning_pipeline .run (
      instance_builder
        .build (configuration)
    ) .contents

  process_instance_with (conf : Configuration) (errors : Option [String] ) : String =
    match errors
      case Some (error) ==> serializer .serialize_errors (error)
      case None ==> serializer .serialize_response (process_configuration (conf) )

  process_instance (maybe_conf : Option [Configuration] ) : String =
    match maybe_conf
      case Some (conf) ==> process_instance_with (conf) (cv .validate (conf) )
      case None ==> error_configuration_is_undefined

  get_maybe_configuration (file_name : String) : Option [Configuration] =
    yaml_parser .parse ( @new StringReader (read_file (file_name) ) )

  process_input_file (file_name : String) : String =
    process_instance (
      get_maybe_configuration (file_name)
    )

  execute (arguments : List [String] ) : Unit =
    if (arguments .length > 0)
    then println (process_input_file (arguments (0) ) )
    else println (help)

  main (arguments : Array [String] ) : Unit =
    execute (arguments .toList)

end

