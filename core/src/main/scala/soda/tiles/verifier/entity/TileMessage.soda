
directive lean
import soda.tiles.verifier.entity.Entity


class TilePair [A : Type] [B : Type]

  abstract
    fst : A
    snd : B

end


class TileTriple [A : Type] [B : Type] [C : Type]

  abstract
    fst : A
    snd : B
    trd : C

end


class TileQuad [A : Type] [B : Type] [C : Type] [D : Type]

  abstract
    fst : A
    snd : B
    trd : C
    fth : D

end


class TileMessage [A : Type]

  abstract
    context : RuleSeq
    instance : Trajectory
    contents : A

end


class TileMessageBuilder

  abstract

  build [A : Type] (context : Context) (instance : Instance) (contents : A) : TileMessage [A] =
    TileMessage .mk (context) (instance) (contents)

end


class InstanceBuilder

  abstract

  build (configuration : Configuration) : TileMessage [Boolean] =
    TileMessageBuilder .mk .build (configuration .rules) (configuration .trajectory) (true)

end

