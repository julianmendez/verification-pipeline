
class Identifier = String


class IdentifierSet = Set [Identifier]


class FluentName = Identifier


class FluentValue = Identifier


class FluentSet = IdentifierSet


class FluentMap = Map [FluentValue] [FluentName]


class Action = Identifier


class ActionSet = IdentifierSet


class Transition

  abstract
    input : FluentSet
    actions : ActionSet
    output : FluentSet

end


class TransitionSeq = Seq [Transition]


class Trajectory = Seq [IdentifierSet]


class Instance = Trajectory

