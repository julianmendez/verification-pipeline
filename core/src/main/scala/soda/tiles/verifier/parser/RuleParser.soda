
class RuleParser

  abstract

  identifier = "rule"

  keyword_rule = "rule"

  keyword_input_fluent = "input_fluent"

  keyword_input = "input"

  keyword_output = "output"

  keyword_action = "action"

  keyword_actions = "actions"

  parse_set_of_strings (part : Any) : Option [Set [String] ] =
    match part
      case s : Seq [Any] ==>
        Some (
          s .map (lambda elem --> elem .toString)
            .toSet
        )
      case otherwise ==> None

  parse_fluents (part : Any) : Option [FluentSet] =
    parse_set_of_strings (part)

  parse_actions_with (part : Any) : Option [FluentSet] =
    parse_set_of_strings (part)

  parse_fluent (part : Any) : Option [FluentValue] =
    match part
      case ("input_fluent" , value) ==> Some (value .toString)
      case otherwise ==> None

  parse_input (part : Any) : Option [FluentSet] =
    match part
      case ("input" , value) ==> parse_fluents (value)
      case otherwise ==> None

  parse_output (part : Any) : Option [FluentSet] =
    match part
      case ("output" , value) ==> parse_fluents (value)
      case otherwise ==> None

  parse_action (part : Any) : Option [Action] =
    match part
      case ("action" , value) ==> Some (value .toString)
      case otherwise ==> None

  parse_actions (part : Any) : Option [ActionSet] =
    match part
      case ("actions" , value) ==> parse_actions_with (value)
      case otherwise ==> None

  parse_CausesIfRule (maybe_input : Option [FluentSet] ) (maybe_action : Option [Action] ) (maybe_output : Option [FluentSet] ) : Option [CausesIfRule] =
    if (maybe_input .isDefined and maybe_action .isDefined and maybe_output .isDefined)
    then Some (CausesIfRule (maybe_input .get , maybe_action .get , maybe_output .get) )
    else None

  parse_IfRule (maybe_input : Option [FluentSet] ) (maybe_output : Option [FluentSet] ) : Option [IfRule] =
    if (maybe_input .isDefined and maybe_output .isDefined)
    then Some (IfRule (maybe_input .get , maybe_output .get) )
    else None

  parse_TriggersRule (maybe_input : Option [FluentSet] ) (maybe_action : Option [Action] ) : Option [TriggersRule] =
    if (maybe_input .isDefined and maybe_action .isDefined)
    then Some (TriggersRule (maybe_input .get , maybe_action .get) )
    else None

  parse_AllowsRule (maybe_input : Option [FluentSet] ) (maybe_action : Option [Action] ) : Option [AllowsRule] =
    if (maybe_input .isDefined and maybe_action .isDefined)
    then Some (AllowsRule (maybe_input .get , maybe_action .get) )
    else None

  parse_InhibitsRule (maybe_input : Option [FluentSet] ) (maybe_action : Option [Action] ) : Option [InhibitsRule] =
    if (maybe_input .isDefined and maybe_action .isDefined)
    then Some (InhibitsRule (maybe_input .get , maybe_action .get) )
    else None

  parse_NoConcurrencyRule (maybe_actions : Option [ActionSet] ) : Option [NoConcurrencyRule] =
    if (maybe_actions .isDefined)
    then Some (NoConcurrencyRule (maybe_actions .get) )
    else None

  parse_DefaultRule (maybe_fluent : Option [FluentValue] ) : Option [DefaultRule] =
    if (maybe_fluent .isDefined)
    then Some (DefaultRule (maybe_fluent .get) )
    else None

  parse_InfluencesIfRule (maybe_input : Option [FluentSet] ) (maybe_action : Option [Action] ) (maybe_output : Option [FluentSet] ) : Option [InfluencesIfRule] =
    if (maybe_input .isDefined and maybe_action .isDefined and maybe_output .isDefined)
    then Some (InfluencesIfRule (maybe_input .get , maybe_action .get , maybe_output .get) )
    else None

  parse_InfluencesRule (maybe_input : Option [FluentSet] ) (maybe_output : Option [FluentSet] ) : Option [InfluencesRule] =
    if (maybe_input .isDefined and maybe_output .isDefined)
    then Some (InfluencesRule (maybe_input .get , maybe_output .get) )
    else None

  parse_FacilitatesRule (maybe_input : Option [FluentSet] ) (maybe_action : Option [Action] ) : Option [FacilitatesRule] =
    if (maybe_input .isDefined and maybe_action .isDefined)
    then Some (FacilitatesRule (maybe_input .get , maybe_action .get) )
    else None

  parse_ContravenesRule (maybe_input : Option [FluentSet] ) (maybe_action : Option [Action] ) : Option [ContravenesRule] =
    if (maybe_input .isDefined and maybe_action .isDefined)
    then Some (ContravenesRule (maybe_input .get , maybe_action .get) )
    else None

  parse_ForbidsToCauseRule (maybe_input : Option [FluentSet] ) (maybe_output : Option [FluentSet] ) : Option [ForbidsToCauseRule] =
    if (maybe_input .isDefined and maybe_output .isDefined)
    then Some (ForbidsToCauseRule (maybe_input .get , maybe_output .get) )
    else None

  parse_rule_for_name (rule_name : Identifier) (s : Seq [Any] ) : Option [Rule] =
    match rule_name
      case "CausesIfRule" ==>
         if (s .length == 4)
         then parse_CausesIfRule (parse_input (s (1) ) ) (parse_action (s (2) ) ) (parse_output (s (3) ) )
         else None
      case "IfRule" ==>
         if (s .length == 3)
         then parse_IfRule (parse_input (s (1) ) ) (parse_output (s (2) ) )
         else None
      case "TriggersRule" ==>
         if (s .length == 3)
         then parse_TriggersRule (parse_input (s (1) ) ) (parse_action (s (2) ) )
         else None
      case "AllowsRule" ==>
         if (s .length == 3)
         then parse_AllowsRule (parse_input (s (1) ) ) (parse_action (s (2) ) )
         else None
      case "InhibitsRule" ==>
         if (s .length == 3)
         then parse_InhibitsRule (parse_input (s (1) ) ) (parse_action (s (2) ) )
         else None
      case "NoConcurrencyRule" ==>
         if (s .length == 2)
         then parse_NoConcurrencyRule (parse_actions (s (1) ) )
         else None
      case "DefaultRule" ==>
         if (s .length == 2)
         then parse_DefaultRule (parse_fluent (s (1) ) )
         else None
      case "InfluencesIfRule" ==>
         if (s .length == 4)
         then parse_InfluencesIfRule (parse_input (s (1) ) ) (parse_action (s (2) ) ) (parse_output (s (3) ) )
         else None
      case "InfluencesRule" ==>
         if (s .length == 3)
         then parse_InfluencesRule (parse_input (s (1) ) ) (parse_output (s (2) ) )
         else None
      case "FacilitatesRule" ==>
         if (s .length == 3)
         then parse_FacilitatesRule (parse_input (s (1) ) ) (parse_action (s (2) ) )
         else None
      case "ContravenesRule" ==>
         if (s .length == 3)
         then parse_ContravenesRule (parse_input (s (1) ) ) (parse_action (s (2) ) )
         else None
      case "ForbidsToCauseRule" ==>
         if (s .length == 3)
         then parse_ForbidsToCauseRule (parse_input (s (1) ) ) (parse_output (s (2) ) )
         else None
      case otherwise ==> None

  parse_rule_with (first : Any) (s : Seq [Any] ) : Option [Rule] =
    match first
      case (name , rule_name) ==>
        if (name == keyword_rule)
        then parse_rule_for_name (rule_name .toString) (s)
        else None
      case otherwise ==> None

  parse_rule (part : Any) : Option [Rule] =
    match part
      case s : Seq [Any] ==>
        if (s .isEmpty)
        then None
        else parse_rule_with (s (0) ) (s)
      case otherwise ==> None

  parse (part : Any) : Option [Rule] =
    parse_rule (part)

end

