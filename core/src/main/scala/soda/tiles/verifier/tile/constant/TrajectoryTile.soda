
directive lean
import Soda.tiles.fairness.tool.TileMessage


/**
 * This tile returns the trajectory.
 */

class TrajectoryTile

  abstract

  get_trajectory (message : TileMessage [Boolean] ) : Instance =
    message .instance

  apply (message : TileMessage [Boolean] ) : TileMessage [Instance] =
    TileMessageBuilder .mk .build (message .context) (message .instance) (
      get_trajectory (message)
    )

end

