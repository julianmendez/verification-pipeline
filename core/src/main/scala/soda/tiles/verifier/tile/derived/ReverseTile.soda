
directive lean
import soda.tiles.verifier.entity.TileMessage

/**
 * This tile reverses a collection.
 */

class ReverseTile [A : Type]

  abstract

  zero : Seq [A] = Seq [A] ()

  prepend (acc : Seq [A] ) (elem : A) : Seq [A] =
    acc .+: (elem)

  fold_tile = FoldTile .mk [A] [Seq [A] ] (zero) (prepend)

  apply (message : TileMessage [Seq [A] ] ) : TileMessage [Seq [A] ] =
    fold_tile .apply (
      message
    )

end

