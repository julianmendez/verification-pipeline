
class Serializer

  abstract

  error_parsing_error = "parsing error possibly caused by a misspelled rule name or YAML key"

  key_all_transitions = "- all_transitions:"

  key_invalid_transitions = "- invalid_transitions:"

  key_iterations = "- iterations: "

  key_errors = "- errors:"

  key_reading_time = "- reading_time: "

  key_validation_time = "- validation_time: "

  key_execution_time = "- execution_time: "

  key_total_time = "- total_time: "

  file_separator = "---"

  serialize_transition (entry : TransitionReport) : String =
    "  - test_index: " + entry .test_index + "\n" +
    "    transition_index: " + entry .transition_index + "\n" +
    "    transition: " + entry .transition + "\n" +
    "    inhibiting_actions: " + entry .inhibiting_actions + "\n" +
    "    rule: " + entry .rule + "\n" +
    "    valid: " + entry .valid + "\n"

  serialize_all_transitions (transitions : Seq [TransitionReport] ) : String =
    if (transitions .nonEmpty)
    then
        key_all_transitions + "\n" +
        transitions
          .map (lambda x --> serialize_transition (x) )
          .mkString
    else ""

  serialize_invalid_transitions (transitions : Seq [TransitionReport] ) : String =
    if (transitions
      .filter (lambda x --> not x .valid)
      .nonEmpty)
    then
       key_invalid_transitions + "\n" +
        transitions
          .filter (lambda x --> not x .valid)
          .map (lambda x --> serialize_transition (x) )
          .mkString
    else ""

  format_nanoseconds (x : Long) : String =
    "" + (x / 1000000) + " ms"

  serialize_time_measures (reading_time : Long) (validation_time : Long) (execution_time : Long) : String =
    key_reading_time + format_nanoseconds(reading_time) + "\n" +
    key_validation_time + format_nanoseconds(validation_time) + "\n" +
    key_execution_time + format_nanoseconds(execution_time) + "\n" +
    key_total_time + format_nanoseconds(reading_time + validation_time + execution_time) + "\n"

  serialize_errors (errors : Seq [String] ) : String =
    if (errors .nonEmpty)
    then
      key_errors + "\n" +
        (errors
          .map (lambda x --> "  - " + x)
          .mkString ("\n")
        ) + "\n"
    else ""

  serialize_iterations (iterations : Int) : String =
    key_iterations + iterations + "\n"

  serialize (report : FinalReport) : String =
    file_separator + "\n" +
    serialize_errors (report .errors) +
    serialize_iterations (report .iterations) +
    serialize_time_measures (report .reading_time) (report .validation_time) (report .execution_time) +
    serialize_invalid_transitions (report .transitions) +
    serialize_all_transitions (report .transitions)

end

